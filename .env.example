# 공공데이터포털 (https://www.data.go.kr/) API 인증키
PUBLIC_DATA_API_KEY=

# OpenAPI 베이스 URL (데이터셋별로 다를 수 있음)
PUBLIC_DATA_BASE_URL=https://apis.data.go.kr

# 공개 사이트 URL (서버용, 권장) — 네이버 RSS/사이트맵 도메인과 일치해야 함
SITE_URL=https://fci.infocs.co.kr

# (선택) 클라에서도 쓸 때만. Vercel이 NEXT_PUBLIC_ 경고를 내면 SITE_URL만 쓰면 됨
# NEXT_PUBLIC_SITE_URL=https://fci.infocs.co.kr

# 선택: 문의/신청 웹훅
# INQUIRY_WEBHOOK_URL=
